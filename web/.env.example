# API
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Web Push (VAPID) — chave PÚBLICA (par da chave privada guardada só no
# backend), roadmap Delivery Fase 4. Preencher no `.env` local, nunca
# commitar o valor real.
VITE_VAPID_PUBLIC_KEY=

# Mercado Pago — chaves PÚBLICAS do MP.js (par de `MERCADOPAGO_*_PROD`/`_TEST`
# no backend, ver api/config/services.php), usadas só para tokenizar cartão
# no navegador ao trocar o cartão da assinatura (`ChangeCardDialog`). Nunca a
# chave de acesso privada aqui — só a pública, segura para expor no bundle.
# ENVIRONMENT escolhe qual par usar ('test', padrão seguro, ou 'production').
VITE_MERCADOPAGO_ENVIRONMENT=test
VITE_MERCADOPAGO_PUBLIC_KEY_TEST=
VITE_MERCADOPAGO_PUBLIC_KEY_PROD=

# Cloudflare Turnstile — site key PÚBLICA do widget (par da secret key no
# backend, ver api/config/services.php 'turnstile'). Vazio = componente
# TurnstileWidget não renderiza nada e o formulário segue funcionando sem
# CAPTCHA (o backend também tolera ausência de token enquanto a secret key
# não estiver configurada).
VITE_TURNSTILE_SITE_KEY=

# E2E — smoke test autenticado (postdeploy-smoke.spec.ts), opcional
SMOKE_LOGIN_EMAIL=
SMOKE_LOGIN_PASSWORD=
