# Aplicação
APP_NAME=PegaTicket
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=https://pegaticket.kleuza.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
# PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# Localização
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

# Log
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Banco de dados
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Banco legado (Fase 8 — staging só-leitura com o dump legado importado)
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=pegaticket_legacy_staging
LEGACY_DB_USERNAME=root
LEGACY_DB_PASSWORD=root

# Sessão
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Broadcast, filesystem e fila
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

# Armazenamento de mídia / Cloudflare R2 (local por padrão; habilite R2 quando
# quiser mover logo/avatar/imagens de evento e anexos para Cloudflare R2)
R2_ENABLED=false
MEDIA_AVATARS_DISK=public
MEDIA_TICKET_TYPES_DISK=public
MEDIA_EVENTS_DISK=public
MEDIA_TENANTS_DISK=public
MEDIA_VENUES_DISK=public
MEDIA_USE_DIRECT_PUBLIC_URLS=true
MEDIA_PUBLIC_CACHE_SECONDS=31536000
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=pegaticket
R2_PREFIX_AVATARS=avatars
R2_PREFIX_EVENTS=events
R2_PREFIX_TENANTS=tenants
R2_PREFIX_TICKET_TYPES=ticket_types
R2_PREFIX_VENUES=venues
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_REGION=auto
R2_USE_PATH_STYLE_ENDPOINT=true

# Cache
CACHE_STORE=database
# CACHE_PREFIX=

# Memcached
MEMCACHED_HOST=127.0.0.1

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# E-mail
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Fallback de envio (hub de comunicação): nome do mailer secundário a
# tentar quando o MAIL_MAILER principal falhar. Vazio = fallback
# desabilitado. Preencher com "smtp_fallback" + as credenciais reais de um
# segundo provedor SMTP abaixo para habilitar.
MAIL_MAILER_FALLBACK=
MAIL_FALLBACK_SCHEME=null
MAIL_FALLBACK_HOST=127.0.0.1
MAIL_FALLBACK_PORT=2525
MAIL_FALLBACK_USERNAME=null
MAIL_FALLBACK_PASSWORD=null

# Web Push (VAPID) — notificações de venda pro portal do cliente final
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Vite (build do frontend)
VITE_APP_NAME="${APP_NAME}"

# Regras de negócio
PARCELA_VENCIMENTO_DIA=10

# Pagamentos — Mercado Pago (assinatura clube→PegaTicket)
# PSP real (roadmap Fase B, item 1). PAYMENT_PROVIDER=manual (default) não
# muda nada do comportamento atual; mudar para "mercadopago" liga o adapter
# real assim que as credenciais abaixo forem preenchidas.
PAYMENT_PROVIDER=mercadopago
MERCADOPAGO_ENVIRONMENT=test
# Painel: https://www.mercadopago.com.br/developers/panel
# 1) Crie/abra uma aplicação em "Suas integrações".
# 2) Defina MERCADOPAGO_ENVIRONMENT como "test" ou "production".
# 3) Preencha as credenciais do ambiente correspondente. O Mercado Pago não
#    usa URL de sandbox separada; o próprio token define o ambiente.
# 4) Aba "Webhooks" > "Configurar notificações" > "Chave secreta" para
#    MERCADOPAGO_WEBHOOK_SECRET (validação do header x-signature).
# Compatibilidade legada: MERCADOPAGO_ACCESS_TOKEN / MERCADOPAGO_PUBLIC_KEY
# ainda funcionam como fallback único, mas o recomendado é usar os pares
# abaixo por ambiente.
MERCADOPAGO_ACCESS_TOKEN_TEST=
MERCADOPAGO_PUBLIC_KEY_TEST=
MERCADOPAGO_TEST_PAYER_EMAIL=
MERCADOPAGO_ACCESS_TOKEN_PROD=
MERCADOPAGO_PUBLIC_KEY_PROD=
MERCADOPAGO_WEBHOOK_SECRET=
# TTL (segundos) do lock de idempotência persistida contra chamadas
# duplicadas ao Mercado Pago (ver payment_idempotency_keys).
MERCADOPAGO_IDEMPOTENCY_LOCK_SECONDS=120

# Pagamentos — PagBank (venda de ingresso, comprador→clube)
# Rail opcional, só afeta SalePaymentService/StorefrontCheckoutService.
# Vazio/ausente (default) herda PAYMENT_PROVIDER acima (comportamento de
# hoje). Definir como "pagbank" liga PagBankPaymentProvider (STUB
# estrutural, sem chamada HTTP real ainda — ver
# App\Services\Payment\PagBankPaymentProvider) SEM afetar a assinatura
# Clube->PegaTicket, que continua só em Mercado Pago.
SALE_PAYMENT_PROVIDER=
# Credenciais ainda não obtidas nesta onda; enquanto vazias,
# PagBankPaymentProvider se comporta como o ManualPaymentProvider (cobrança
# nasce pending, conciliação manual).
PAGBANK_ENVIRONMENT=sandbox
PAGBANK_TOKEN_SANDBOX=
PAGBANK_TOKEN_PROD=

# Cloudflare Turnstile (CAPTCHA, vendor gratuito) — deixar vazio = modo
# desabilitado (não bloqueia formularios publicos, ver
# App\Services\Security\TurnstileVerificationService)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
